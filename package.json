{
  "name": "cereja-ui-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "node scripts/generate-doc-examples.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/sync-demo-assets.mjs && playwright test tests/e2e",
    "test:providers": "node scripts/sync-demo-assets.mjs && playwright test tests/providers",
    "docs:dev": "node scripts/generate-doc-examples.mjs && node scripts/sync-demo-assets.mjs && vite --config apps/docs/vite.config.ts",
    "pack:delivery": "node scripts/package-delivery.mjs",
    "test:consumer": "node tests/consumer/check.mjs",
    "format": "prettier --write packages apps tests scripts *.ts *.json docs",
    "docs:preview": "vite preview --config apps/docs/vite.config.ts",
    "docs:generate": "node scripts/generate-doc-examples.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vimeo/player": "^2.30.4",
    "dashjs": "^5.3.0",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vimeo__player": "^2.18.3",
    "@types/youtube": "^0.3.0",
    "axe-core": "^4.14.0",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-transpiler": "npm:typescript@^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
